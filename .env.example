# LLM Token Optimizer Environment Variables
# Copy this file to .env and fill in your actual API keys

# ===========================================
# FAST TIER CONFIGURATION (REQUIRED)
# ===========================================
# Primary LLM provider for fast responses and cost optimization
# Supports Azure AI Inference and Groq API endpoints

# Azure AI Inference (Recommended)
# Get your API key from: https://azure.microsoft.com/en-us/products/ai-services/ai-inference
LLM_API_KEY=your-azure-inference-api-key-here

# Alternative: Groq API
# Get your free API key from: https://console.groq.com/keys
# LLM_API_KEY=gsk_your-groq-api-key-here

# Fast Tier Model Selection
# Options for Azure AI Inference:
# - gpt-4o-mini (Recommended - fast and cost-effective)
# - gpt-4o (More capable)
# - text-davinci-003 (Legacy)
#
# Options for Groq:
# - llama-3.1-8b-instant (Very fast)
# - llama-3.3-70b-versatile (More accurate)
# - mixtral-8x7b-32768 (Large context window)
LLM_MODEL=gpt-4o-mini

# ===========================================
# GEMINI CONFIGURATION (OPTIONAL)
# ===========================================
# Google's Gemini AI for advanced reasoning capabilities
# Get your API key from: https://aistudio.google.com/app/apikey

# Leave empty if not using Gemini features
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# SERVER CONFIGURATION (OPTIONAL)
# ===========================================

# Server port (default: 8080)
# SERVER_PORT=8080

# Spring profile (default: production)
# Options: dev, prod, test
# SPRING_PROFILES_ACTIVE=prod

# ===========================================
# DEVELOPMENT SETTINGS (OPTIONAL)
# ===========================================

# Enable debug logging
# LOGGING_LEVEL_COM_EXAMPLE_DEMO=DEBUG

# Enable detailed API metrics
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# File upload settings (in MB)
# SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50
# SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Never commit your actual .env file to version control
# 2. Keep API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Monitor API usage and costs
# 5. Implement proper access controls in production
